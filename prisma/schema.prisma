// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum AssistanceCaseStatus {
  SUBMITTED
  QUALIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum AssistanceUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AssistanceType {
  DOCUMENT_LOSS
  ARREST_DETENTION
  ACCIDENT
  MEDICAL_EMERGENCY
  VIOLENCE_ABUSE
  REPATRIATION
  DEATH
  LEGAL_ASSISTANCE
  OTHER
}

enum AssistanceHistoryAction {
  CREATED
  QUALIFIED
  ASSIGNED
  STATUS_CHANGED
  UPDATED
  RESOLVED
  CLOSED
  REJECTED
}

enum DiplomaticPostStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PreferredLanguage {
  FR
  EN
}

enum RoleScope {
  GLOBAL
  POST
  SERVICE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  ENDED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  MFA_OTP
}

enum CensusStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  VERIFIED
  REJECTED
}

enum ContactChannel {
  EMAIL
  SMS
  PUSH
}

enum ResidenceStatus {
  CITIZEN
  PERMANENT_RESIDENT
  WORKER
  STUDENT
  REFUGEE_ASYLUM_SEEKER
  TEMPORARY_RESIDENT
  OTHER
}

enum DepartureReason {
  STUDIES
  WORK
  FAMILY_REUNIFICATION
  BUSINESS
  PROTECTION
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  ENTREPRENEUR
  SELF_EMPLOYED
  STUDENT
  UNEMPLOYED
  RETIRED
  OTHER
}

enum CensusDocumentType {
  IDENTITY_DOCUMENT
  RESIDENCE_PROOF
  OTHER
}

enum CensusDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CensusReviewDecision {
  VERIFIED
  CORRECTION_REQUIRED
  REJECTED
}

enum MentorshipRequestStatus {
  SUBMITTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum MentorshipHistoryAction {
  CREATED
  MATCHED
  STARTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AssociationCategory {
  PROFESSIONAL
  STUDENT
  CULTURAL
  COMMUNITY
  ECONOMIC
  SCIENTIFIC
  REGIONAL
  HUMANITARIAN
  OTHER
}

enum AssociationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum AssociationMemberRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY_GENERAL
  TREASURER
  COMMUNICATION_OFFICER
  AUDITOR
  LEGAL_ADVISOR
  MEMBER
}

enum AssociationHistoryAction {
  CREATED
  UPDATED
  SUBMITTED
  ASSIGNED
  REVIEW_STARTED
  CORRECTION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  REACTIVATED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  CENSUS_STATUS
  ASSISTANCE_STATUS
  ASSOCIATION_STATUS
  PUBLICATION_ALERT
  MENTORSHIP_INVITE
  SYSTEM_SECURITY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

/**
 * |--------------------------------------------------------------------------
 * | PUBLICATIONS & VALORISATION (MPV) ENUMS
 * |--------------------------------------------------------------------------
 */

enum PublicationType {
  OFFICIAL_ANNOUNCEMENT
  CONSULAR_NOTICE
  SUCCESS_STORY
  ASSOCIATION_EVENT
  OPPORTUNITY
  COMMUNITY_ARTICLE
}

enum PublicationStatus {
  DRAFT
  SUBMITTED
  PENDING_LEVEL1_REVIEW
  PENDING_LEVEL2_APPROVAL
  PUBLISHED
  CORRECTION_REQUIRED
  REJECTED
  ARCHIVED
}

enum PublicationTargetScope {
  GLOBAL_PUBLIC
  DIASPORA_VERIFIED
  POST_RESTRICTED
}

enum PublicationReviewLevel {
  LEVEL1_MODERATION
  LEVEL2_FINAL_APPROVAL
}

enum PublicationReviewDecision {
  VALIDATED_TO_LEVEL2
  APPROVED_AND_PUBLISHED
  CORRECTION_REQUESTED
  REJECTED
}

/**
 * |--------------------------------------------------------------------------
 * | GEOGRAPHY
 * |--------------------------------------------------------------------------
 */

model Country {
  id       String @id @default(uuid()) @db.Uuid
  iso2Code String @unique @map("iso2_code") @db.Char(2)
  iso3Code String @unique @map("iso3_code") @db.Char(3)
  name     String @unique @db.VarChar(150)

  dialingCode String? @map("dialing_code") @db.VarChar(10)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hostedPosts   DiplomaticPost[] @relation("PostHostCountry")
  postCoverages PostCoverage[]

  assistanceCases AssistanceCase[]

  censusResidenceRecords   CensusRecord[] @relation("CensusResidenceCountry")
  censusNationalityRecords CensusRecord[] @relation("CensusNationalityCountry")

  associations Association[]

  @@index([isActive])
  @@map("countries")
}

/**
 * |--------------------------------------------------------------------------
 * | DIPLOMATIC POST TYPES
 * |--------------------------------------------------------------------------
 */

model PostType {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @unique @db.VarChar(100)

  description String? @db.Text

  minCoverageCount Int  @default(0) @map("min_coverage_count")
  maxCoverageCount Int? @map("max_coverage_count")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts DiplomaticPost[]

  @@index([isActive])
  @@map("post_types")
}

/**
 * |--------------------------------------------------------------------------
 * | DIPLOMATIC AND CONSULAR POSTS
 * |--------------------------------------------------------------------------
 */

model DiplomaticPost {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(50)
  name String @db.VarChar(200)

  typeId String   @map("type_id") @db.Uuid
  type   PostType @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status DiplomaticPostStatus @default(ACTIVE)

  hostCountryId String?  @map("host_country_id") @db.Uuid
  hostCountry   Country? @relation("PostHostCountry", fields: [hostCountryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  city    String? @db.VarChar(150)
  address String? @db.VarChar(255)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  openedAt DateTime? @map("opened_at") @db.Date
  closedAt DateTime? @map("closed_at") @db.Date

  parentPostId String?          @map("parent_post_id") @db.Uuid
  parentPost   DiplomaticPost?  @relation("PostHierarchy", fields: [parentPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childPosts   DiplomaticPost[] @relation("PostHierarchy")

  coverages PostCoverage[]
  services  Service[]

  userPostAssignments UserPostAssignment[]
  roleAssignments     UserRoleAssignment[]
  censusRecords       CensusRecord[]
  assistanceCases     AssistanceCase[]
  associations        Association[]
  publications        Publication[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([typeId])
  @@index([hostCountryId])
  @@index([parentPostId])
  @@index([status])
  @@index([name])
  @@map("diplomatic_posts")
}

/**
 * |--------------------------------------------------------------------------
 * | DIPLOMATIC POST GEOGRAPHIC COVERAGE
 * |--------------------------------------------------------------------------
 */

model PostCoverage {
  id String @id @default(uuid()) @db.Uuid

  postId String         @map("post_id") @db.Uuid
  post   DiplomaticPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  competenceNature String? @map("competence_nature") @db.VarChar(100)

  startDate DateTime  @default(now()) @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([postId, countryId, startDate])
  @@index([postId])
  @@index([countryId])
  @@index([countryId, endDate])
  @@map("post_coverages")
}

/**
 * |--------------------------------------------------------------------------
 * | DIPLOMATIC POST SERVICES
 * |--------------------------------------------------------------------------
 */

model Service {
  id String @id @default(uuid()) @db.Uuid

  postId String         @map("post_id") @db.Uuid
  post   DiplomaticPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  code String @db.VarChar(50)
  name String @db.VarChar(150)

  serviceType String? @map("service_type") @db.VarChar(100)
  description String? @db.Text

  status ServiceStatus @default(ACTIVE)

  userPostAssignments UserPostAssignment[]
  roleAssignments     UserRoleAssignment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([postId, code])
  @@index([postId])
  @@index([status])
  @@index([name])
  @@map("services")
}

/**
 * |--------------------------------------------------------------------------
 * | USERS
 * |--------------------------------------------------------------------------
 */

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(50)

  phone String? @unique @db.VarChar(30)

  passwordHash String? @map("password_hash") @db.VarChar(255)

  status UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  profile UserProfile?

  roleAssignments UserRoleAssignment[]
  postAssignments UserPostAssignment[]

  verificationTokens VerificationToken[]
  authSessions       AuthSession[]

  censusRecords       CensusRecord[]
  censusReviews       CensusReview[]        @relation("CensusReviewer")
  censusStatusChanges CensusStatusHistory[] @relation("CensusStatusChangedBy")

  assistanceCasesCreated  AssistanceCase[]        @relation("AssistanceRequester")
  assistanceCasesAssigned AssistanceCase[]        @relation("AssistanceAssignedAgent")
  assistanceHistory       AssistanceCaseHistory[] @relation("AssistanceHistoryActor")

  mentorshipRequestsCreated  MentorshipRequest[]        @relation("MentorshipRequester")
  mentorshipRequestsMentored MentorshipRequest[]        @relation("MentorshipMentor")
  mentorshipHistory          MentorshipRequestHistory[] @relation("MentorshipHistoryActor")

  associationsCreated          Association[]           @relation("AssociationCreator")
  associationsValidated        Association[]           @relation("AssociationValidator")
  associationMemberships       AssociationMembership[]
  associationDocumentsUploaded AssociationDocument[]   @relation("AssociationDocumentUploader")
  associationHistory           AssociationHistory[]    @relation("AssociationHistoryActor")

  publicationsAuthored         Publication[]              @relation("PublicationAuthor")
  publicationReviews           PublicationReviewHistory[] @relation("PublicationReviewer")

  notificationsReceived   Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@index([email])
  @@index([username])
  @@map("users")
}

/**
 * |--------------------------------------------------------------------------
 * | USER PROFILE
 * |--------------------------------------------------------------------------
 */

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)

  displayName String? @map("display_name") @db.VarChar(200)
  photoUrl    String? @map("photo_url") @db.VarChar(500)

  preferredLanguage PreferredLanguage @default(FR) @map("preferred_language")

  residenceCountry String?  @map("residence_country") @db.VarChar(150)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastName, firstName])
  @@map("user_profiles")
}

/**
 * |--------------------------------------------------------------------------
 * | ROLES
 * |--------------------------------------------------------------------------
 */

model Role {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(80)
  name String @unique @db.VarChar(120)

  description String? @db.Text

  scope RoleScope @default(GLOBAL)

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  userAssignments UserRoleAssignment[]
  permissions     RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([scope])
  @@index([isActive])
  @@map("roles")
}

/**
 * |--------------------------------------------------------------------------
 * | PERMISSIONS
 * |--------------------------------------------------------------------------
 */

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(120)
  name String @db.VarChar(150)

  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permissions")
}

/**
 * |--------------------------------------------------------------------------
 * | ROLE <-> PERMISSION
 * |--------------------------------------------------------------------------
 */

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/**
 * |--------------------------------------------------------------------------
 * | USER ROLE ASSIGNMENTS
 * |--------------------------------------------------------------------------
 */

model UserRoleAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  postId String?         @map("post_id") @db.Uuid
  post   DiplomaticPost? @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceId String?  @map("service_id") @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  isActive Boolean @default(true) @map("is_active")

  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([roleId])
  @@index([postId])
  @@index([serviceId])
  @@index([userId, isActive])
  @@map("user_role_assignments")
}

/**
 * |--------------------------------------------------------------------------
 * | ORGANISATIONAL ASSIGNMENT
 * |--------------------------------------------------------------------------
 */

model UserPostAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  postId String @map("post_id") @db.Uuid

  serviceId String? @map("service_id") @db.Uuid

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post    DiplomaticPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  jobTitle String? @map("job_title") @db.VarChar(150)

  status    AssignmentStatus @default(ACTIVE)
  isPrimary Boolean          @default(false) @map("is_primary")

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([postId])
  @@index([serviceId])
  @@index([status])
  @@index([userId, status])
  @@map("user_post_assignments")
}

/**
 * |--------------------------------------------------------------------------
 * | VERIFICATION TOKENS
 * |--------------------------------------------------------------------------
 */

model VerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type VerificationTokenType

  tokenHash String @map("token_hash") @db.VarChar(255)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/**
 * |--------------------------------------------------------------------------
 * | AUTH SESSIONS
 * |--------------------------------------------------------------------------
 */

model AuthSession {
  consumedRefreshTokens ConsumedRefreshToken[]

  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // On ne stocke jamais le refresh token brut.
  refreshTokenHash String @map("refresh_token_hash") @db.VarChar(255)

  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model ConsumedRefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @map("session_id") @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Hash uniquement : aucun refresh token brut.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz(3)

  @@index([sessionId])
  @@map("consumed_refresh_tokens")
}

/**
 * |--------------------------------------------------------------------------
 * | CENSUS / RECENSEMENT
 * |--------------------------------------------------------------------------
 */

model CensusRecord {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(40)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status CensusStatus @default(DRAFT)

  // Snapshot d'identité au moment du recensement.
  firstName  String?   @map("first_name") @db.VarChar(100)
  lastName   String?   @map("last_name") @db.VarChar(100)
  birthDate  DateTime? @map("birth_date") @db.Date
  birthPlace String?   @map("birth_place") @db.VarChar(150)

  nationalityCountryId String?  @map("nationality_country_id") @db.Uuid
  nationalityCountry   Country? @relation("CensusNationalityCountry", fields: [nationalityCountryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Coordonnées de contact utilisées pour le dossier de recensement.
  email                   String?         @db.VarChar(255)
  primaryPhone            String?         @map("primary_phone") @db.VarChar(30)
  secondaryPhone          String?         @map("secondary_phone") @db.VarChar(30)
  preferredContactChannel ContactChannel? @map("preferred_contact_channel")

  // Résidence dans la diaspora.
  residenceCountryId String?  @map("residence_country_id") @db.Uuid
  residenceCountry   Country? @relation("CensusResidenceCountry", fields: [residenceCountryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  residenceCity       String?          @map("residence_city") @db.VarChar(150)
  residenceAddress    String?          @map("residence_address") @db.VarChar(255)
  residencePostalCode String?          @map("residence_postal_code") @db.VarChar(30)
  latitude            Decimal?         @db.Decimal(9, 6)
  longitude           Decimal?         @db.Decimal(9, 6)
  residenceSinceYear  Int?             @map("residence_since_year")
  residenceStatus     ResidenceStatus? @map("residence_status")

  // Rattachement au Cameroun.
  cameroonRegion      String?          @map("cameroon_region") @db.VarChar(100)
  cameroonCity        String?          @map("cameroon_city") @db.VarChar(150)
  lastCameroonAddress String?          @map("last_cameroon_address") @db.VarChar(255)
  departureYear       Int?             @map("departure_year")
  departureReason     DepartureReason? @map("departure_reason")

  // Situation familiale.
  maritalStatus   MaritalStatus? @map("marital_status")
  dependantsCount Int?           @map("dependants_count")

  // Situation professionnelle.
  employmentStatus EmploymentStatus? @map("employment_status")
  profession       String?           @db.VarChar(150)
  jobTitle         String?           @map("job_title") @db.VarChar(150)
  sector           String?           @db.VarChar(150)
  employer         String?           @db.VarChar(200)
  yearsExperience  Int?              @map("years_experience")

  // Informations utiles au futur module Talent.
  expertiseDomains     String[] @default([]) @map("expertise_domains")
  skills               String[] @default([])
  qualifications       String?  @db.Text
  optInTalentDirectory Boolean  @default(false) @map("opt_in_talent_directory")

  // Poste calculé à partir de la couverture territoriale.
  assignedPostId String?         @map("assigned_post_id") @db.Uuid
  assignedPost   DiplomaticPost? @relation(fields: [assignedPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  routedAt       DateTime?       @map("routed_at") @db.Timestamptz(3)

  // Déclarations et consentements.
  declaredAccurate      Boolean @default(false) @map("declared_accurate")
  consentDataProcessing Boolean @default(false) @map("consent_data_processing")
  privacyNoticeAccepted Boolean @default(false) @map("privacy_notice_accepted")

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(3)

  documents     CensusDocument[]
  reviews       CensusReview[]
  statusHistory CensusStatusHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([residenceCountryId])
  @@index([assignedPostId])
  @@map("census_records")
}

model CensusDocument {
  id String @id @default(uuid()) @db.Uuid

  censusRecordId String       @map("census_record_id") @db.Uuid
  censusRecord   CensusRecord @relation(fields: [censusRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type   CensusDocumentType
  status CensusDocumentStatus @default(PENDING)

  documentNumber String?   @map("document_number") @db.VarChar(100)
  issuingCountry String?   @map("issuing_country") @db.VarChar(150)
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date

  storageKey   String  @map("storage_key") @db.VarChar(500)
  originalName String  @map("original_name") @db.VarChar(255)
  mimeType     String? @map("mime_type") @db.VarChar(100)
  sizeBytes    Int?    @map("size_bytes")

  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([censusRecordId])
  @@index([type])
  @@index([status])
  @@map("census_documents")
}

model CensusReview {
  id String @id @default(uuid()) @db.Uuid

  censusRecordId String       @map("census_record_id") @db.Uuid
  censusRecord   CensusRecord @relation(fields: [censusRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer   User   @relation("CensusReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  decision CensusReviewDecision
  comment  String?              @db.Text

  correctionFields String[] @default([]) @map("correction_fields")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([censusRecordId])
  @@index([reviewerId])
  @@index([decision])
  @@map("census_reviews")
}

model CensusStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  censusRecordId String       @map("census_record_id") @db.Uuid
  censusRecord   CensusRecord @relation(fields: [censusRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fromStatus CensusStatus? @map("from_status")
  toStatus   CensusStatus  @map("to_status")

  changedById String? @map("changed_by_id") @db.Uuid
  changedBy   User?   @relation("CensusStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  reason String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([censusRecordId])
  @@index([changedById])
  @@index([toStatus])
  @@index([createdAt])
  @@map("census_status_history")
}

/**
 * |--------------------------------------------------------------------------
 * | ASSISTANCE & PROTECTION
 * |--------------------------------------------------------------------------
 */

model AssistanceCase {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(40)

  /**
   * |--------------------------------------------------------------------------
   * | Requester
   * |--------------------------------------------------------------------------
   */

  requesterId String @map("requester_id") @db.Uuid
  requester   User   @relation("AssistanceRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /**
   * |--------------------------------------------------------------------------
   * | Request
   * |--------------------------------------------------------------------------
   */

  type       AssistanceType
  categoryId String?              @map("category_id") @db.Uuid
  category   AssistanceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  urgency    AssistanceUrgency    @default(NORMAL)
  status     AssistanceCaseStatus @default(SUBMITTED)

  subject     String @db.VarChar(200)
  description String @db.Text

  /**
   * |--------------------------------------------------------------------------
   * | Location
   * |--------------------------------------------------------------------------
   */

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  city    String? @db.VarChar(150)
  address String? @db.VarChar(255)

  /**
   * |--------------------------------------------------------------------------
   * | Contact snapshot
   * |--------------------------------------------------------------------------
   */

  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(30)

  /**
   * |--------------------------------------------------------------------------
   * | Diplomatic routing
   * |--------------------------------------------------------------------------
   */

  assignedPostId String         @map("assigned_post_id") @db.Uuid
  assignedPost   DiplomaticPost @relation(fields: [assignedPostId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  routedAt DateTime @default(now()) @map("routed_at") @db.Timestamptz(3)

  /**
   * |--------------------------------------------------------------------------
   * | Agent assignment
   * |--------------------------------------------------------------------------
   */

  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid
  assignedToUser   User?   @relation("AssistanceAssignedAgent", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(3)

  /**
   * |--------------------------------------------------------------------------
   * | Resolution
   * |--------------------------------------------------------------------------
   */

  resolutionSummary String? @map("resolution_summary") @db.Text

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)

  /**
   * |--------------------------------------------------------------------------
   * | History
   * |--------------------------------------------------------------------------
   */

  history AssistanceCaseHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([requesterId])
  @@index([assignedPostId])
  @@index([assignedToUserId])
  @@index([countryId])
  @@index([status])
  @@index([urgency])
  @@index([createdAt])
  @@map("assistance_cases")
}

model AssistanceCaseHistory {
  id String @id @default(uuid()) @db.Uuid

  caseId         String         @map("case_id") @db.Uuid
  assistanceCase AssistanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("AssistanceHistoryActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  action AssistanceHistoryAction

  fromStatus AssistanceCaseStatus? @map("from_status")
  toStatus   AssistanceCaseStatus? @map("to_status")

  comment String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([caseId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("assistance_case_history")
}

model AssistanceCategory {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique @db.VarChar(50)
  name            String            @db.VarChar(150)
  shortName       String?           @map("short_name") @db.VarChar(100)
  description     String?           @db.Text
  icon            String?           @db.VarChar(50)
  badgeColor      String?           @map("badge_color") @db.VarChar(50)
  defaultUrgency  AssistanceUrgency @default(NORMAL) @map("default_urgency")
  defaultSlaHours Int               @default(24) @map("default_sla_hours")
  isActive        Boolean           @default(true) @map("is_active")
  isSystem        Boolean           @default(false) @map("is_system")
  displayOrder    Int               @default(0) @map("display_order")

  steps AssistanceProtocolStep[]
  cases AssistanceCase[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([code])
  @@index([isActive])
  @@map("assistance_categories")
}

model AssistanceProtocolStep {
  id               String             @id @default(uuid()) @db.Uuid
  categoryId       String             @map("category_id") @db.Uuid
  category         AssistanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stepNumber       Int                @map("step_number")
  title            String             @db.VarChar(150)
  description      String             @db.Text
  recommendedDelay String?            @map("recommended_delay") @db.VarChar(50)
  responsibleRole  String?            @map("responsible_role") @db.VarChar(100)
  requiredDocs     String[]           @default([]) @map("required_docs")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([categoryId, stepNumber])
  @@index([categoryId])
  @@map("assistance_protocol_steps")
}

/**
 * |--------------------------------------------------------------------------
 * | TALENT & MENTORSHIP
 * |--------------------------------------------------------------------------
 */

model MentorshipRequest {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(40)

  requesterId String @map("requester_id") @db.Uuid
  requester   User   @relation("MentorshipRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  mentorId String? @map("mentor_id") @db.Uuid
  mentor   User?   @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  topic      String @db.VarChar(150)
  objectives String @db.Text

  status MentorshipRequestStatus @default(SUBMITTED)

  matchedAt   DateTime? @map("matched_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  history MentorshipRequestHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([requesterId])
  @@index([mentorId])
  @@index([status])
  @@index([createdAt])
  @@map("mentorship_requests")
}

model MentorshipRequestHistory {
  id String @id @default(uuid()) @db.Uuid

  requestId String            @map("request_id") @db.Uuid
  request   MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("MentorshipHistoryActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  action MentorshipHistoryAction

  fromStatus MentorshipRequestStatus? @map("from_status")
  toStatus   MentorshipRequestStatus? @map("to_status")

  comment String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([requestId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("mentorship_request_history")
}

/**
 * |--------------------------------------------------------------------------
 * | ASSOCIATIONS (MCA)
 * |--------------------------------------------------------------------------
 */

model Association {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)

  name        String              @db.VarChar(200)
  acronym     String?             @db.VarChar(50)
  category    AssociationCategory @default(COMMUNITY)
  description String              @db.Text
  objectives  String?             @db.Text
  creationDate DateTime?          @map("creation_date") @db.Date

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  city      String  @db.VarChar(150)
  address   String? @db.VarChar(255)
  postalCode String? @map("postal_code") @db.VarChar(30)

  email      String  @db.VarChar(255)
  phone      String  @db.VarChar(30)
  websiteUrl String? @map("website_url") @db.VarChar(255)
  logoUrl    String? @map("logo_url") @db.VarChar(500)

  diplomaticPostId String         @map("diplomatic_post_id") @db.Uuid
  diplomaticPost   DiplomaticPost @relation(fields: [diplomaticPostId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status         AssociationStatus @default(DRAFT)
  submissionDate DateTime?         @map("submission_date") @db.Timestamptz(3)
  validatedAt    DateTime?         @map("validated_at") @db.Timestamptz(3)

  creatorId String @map("creator_id") @db.Uuid
  creator   User   @relation("AssociationCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  validatedById String? @map("validated_by_id") @db.Uuid
  validator     User?   @relation("AssociationValidator", fields: [validatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  rejectionReason  String? @map("rejection_reason") @db.Text
  suspensionReason String? @map("suspension_reason") @db.Text

  memberships AssociationMembership[]
  documents   AssociationDocument[]
  history     AssociationHistory[]
  publications Publication[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([countryId])
  @@index([diplomaticPostId])
  @@index([status])
  @@index([category])
  @@index([creatorId])
  @@map("associations")
}

model AssociationMembership {
  id String @id @default(uuid()) @db.Uuid

  associationId String      @map("association_id") @db.Uuid
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  role                  AssociationMemberRole @default(MEMBER)
  isLegalRepresentative Boolean               @default(false) @map("is_legal_representative")
  title                 String?               @db.VarChar(100)
  joinedAt              DateTime              @default(now()) @map("joined_at") @db.Timestamptz(3)
  isActive              Boolean               @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([associationId, userId])
  @@index([associationId])
  @@index([userId])
  @@map("association_memberships")
}

model AssociationDocument {
  id String @id @default(uuid()) @db.Uuid

  associationId String      @map("association_id") @db.Uuid
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type     String @db.VarChar(50)
  title    String @db.VarChar(150)
  fileUrl  String @map("file_url") @db.VarChar(500)
  fileKey  String @map("file_key") @db.VarChar(255)
  fileSize Int    @map("file_size")
  mimeType String @map("mime_type") @db.VarChar(100)

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation("AssociationDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([associationId])
  @@index([uploadedById])
  @@map("association_documents")
}

model AssociationHistory {
  id String @id @default(uuid()) @db.Uuid

  associationId String      @map("association_id") @db.Uuid
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("AssociationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  action     AssociationHistoryAction
  fromStatus AssociationStatus?       @map("from_status")
  toStatus   AssociationStatus?       @map("to_status")
  comment    String?                  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([associationId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("association_history")
}

/**
 * |--------------------------------------------------------------------------
 * | NOTIFICATIONS (MNOTIF)
 * |--------------------------------------------------------------------------
 */

model Notification {
  id String @id @default(uuid()) @db.Uuid

  recipientId String @map("recipient_id") @db.Uuid
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type      NotificationType
  priority  NotificationPriority  @default(NORMAL)
  channels  NotificationChannel[] @default([IN_APP])

  title     String  @db.VarChar(150)
  content   String  @db.Text
  actionUrl String? @map("action_url") @db.VarChar(255)
  icon      String? @db.VarChar(50)

  status   NotificationStatus @default(UNREAD)
  metadata Json?              @default("{}")

  sentAt    DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type         NotificationType
  emailEnabled Boolean          @default(true) @map("email_enabled")
  inAppEnabled Boolean          @default(true) @map("in_app_enabled")
  smsEnabled   Boolean          @default(false) @map("sms_enabled")
  pushEnabled  Boolean          @default(true) @map("push_enabled")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}


/**
 * |--------------------------------------------------------------------------
 * | PUBLICATIONS, INFORMATIONS & VALORISATION (MPV)
 * |--------------------------------------------------------------------------
 */

model Publication {
  id String @id @default(uuid()) @db.Uuid

  slug    String @unique @db.VarChar(200)
  title   String @db.VarChar(250)
  summary String @db.Text
  content String @db.Text

  type   PublicationType        @default(COMMUNITY_ARTICLE)
  status PublicationStatus      @default(DRAFT)
  scope  PublicationTargetScope @default(GLOBAL_PUBLIC)

  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  attachments   Json?    @default("[]")
  tags          String[] @default([])

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  diplomaticPostId String?         @map("diplomatic_post_id") @db.Uuid
  diplomaticPost   DiplomaticPost? @relation(fields: [diplomaticPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  associationId String?      @map("association_id") @db.Uuid
  association   Association? @relation(fields: [associationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  viewCount   Int       @default(0) @map("view_count")
  isFeatured  Boolean   @default(false) @map("is_featured")

  reviews PublicationReviewHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@index([type])
  @@index([scope])
  @@index([authorId])
  @@index([diplomaticPostId])
  @@index([associationId])
  @@index([publishedAt])
  @@index([isFeatured])
  @@map("publications")
}

model PublicationReviewHistory {
  id String @id @default(uuid()) @db.Uuid

  publicationId String      @map("publication_id") @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer   User   @relation("PublicationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  level    PublicationReviewLevel
  decision PublicationReviewDecision
  comment  String?                   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publicationId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("publication_review_history")
}
