# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

POSTGRES_USER=minrex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=minrex
POSTGRES_PORT=5432

DATABASE_URL="postgresql://minrex:change_me@localhost:5432/minrex?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_LEVEL=info
LOG_PRETTY=true

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

MAIL_FROM=no-reply@minrex.local
MAIL_FROM_NAME=MINREX

FRONTEND_URL=http://localhost:8080

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800