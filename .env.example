# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

POSTGRES_USER=minrex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=minrex
POSTGRES_PORT=5432

DATABASE_URL="postgresql://minrex:change_me@localhost:5432/minrex?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_LEVEL=info
LOG_PRETTY=true

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Mail (Local dev: Mailpit localhost:1025 | Prod Brevo: smtp-relay.brevo.com:587 | Staging Gmail: smtp.gmail.com:465)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

MAIL_FROM=no-reply@minrex.local
MAIL_FROM_NAME=MINREX
MAIL_REPLY_TO=

# SMTP Connection Pooling & Concurrency (prevents 421 Too many connections on bursts)
MAIL_POOL=true
MAIL_MAX_CONNECTIONS=4
MAIL_MAX_MESSAGES=100
MAIL_RATE_LIMIT=5
MAIL_RATE_DELTA_MS=1000
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=15000

# SMS OTP Gateway (mock | brevo | twilio | infobip | webhook)
SMS_PROVIDER=mock
SMS_SENDER_ID=MINREX-CMR
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=
EXPOSE_DEV_OTP_IN_RESPONSE=true

FRONTEND_URL=http://localhost:8080

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Chatbot
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_ENABLED=true
AI_PROVIDER=gemini
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=30000